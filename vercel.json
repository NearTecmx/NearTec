{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/crm-automatizacion",
      "destination": "/crm/"
    },
    {
      "source": "/diseno-web",
      "destination": "/web/"
    },
    {
      "source": "/api/lead",
      "destination": "/api/lead.js"
    }
  ]
}